              "raw": "{\n  \"text\": \"This is a sample text to check chunking behavior for the selected model.\",\n  \"chunk_size\": 2000,\n  \"auto_chunk\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/embed/check",
