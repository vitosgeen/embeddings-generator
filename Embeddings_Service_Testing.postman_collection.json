    {
      "name": "4) Task Queue (Admin)",
      "item": [
        {
          "name": "Create Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.task_id) {",
                  "  pm.collectionVariables.set('task_id', res.task_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task_type\": \"cleanup_logs\",\n  \"params\": {\n    \"days\": 7\n  },\n  \"name\": \"Cleanup old logs\",\n  \"priority\": 1,\n  \"max_retries\": 3\n}"
            },
            "url": {
              "raw": "{{base_url}}/tasks/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tasks",
                ""
              ]
            },
            "description": "Requires admin API key in {{api_key}}"
